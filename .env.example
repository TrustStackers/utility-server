# Utility server configuration — TEMPLATE (committed).
#
# Copy to `.env` (gitignored), or generate the BOOTSTRAP_* block with:
#   npm run init:bootstrap -- --host <dns-or-ip> ...
#
# The bootstrap block tells this server which bootstrap/relay to register with.
# Without it the server runs in LAN-only mode (the setup wizard still works).

# ── Bootstrap / relay (must match the bootstrap server's .env) ──
BOOTSTRAP_SEED_HEX=
BOOTSTRAP_PEER_ID=
BOOTSTRAP_HOST=
BOOTSTRAP_TCP_PORT=4001
BOOTSTRAP_WS_PORT=4002
BOOTSTRAP_ENABLE_RELAY=true
