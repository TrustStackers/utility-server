# Utility server configuration — TEMPLATE (committed).
#
# Copy to `.env` (gitignored), or generate the BOOTSTRAP_* block with:
#   npm run init:bootstrap -- --component utility-server --host <dns-or-ip> ...
#
# The bootstrap block tells this server which bootstrap/relay to register with.
# Without it the server runs in LAN-only mode (the setup wizard still works).
#
# This is a CLIENT: it holds NO seed. Only the bootstrap server derives its peer
# ID from a word sequence, so this server only needs the address + the peer ID to
# expect. A BOOTSTRAP_SEED_HEX here is refused at startup — remove it.

# ── Bootstrap / relay (must match the bootstrap server's .env) ──
BOOTSTRAP_PEER_ID=
BOOTSTRAP_HOST=
BOOTSTRAP_TCP_PORT=4001
BOOTSTRAP_WS_PORT=4002
BOOTSTRAP_ENABLE_RELAY=true

# ── Logging (optional) ──
# Read at startup by `config/logging-env.ts`, so verbosity lives HERE rather than
# in a package.json script — `P2PTS_LOG_LEVEL=info node …` is POSIX-only syntax
# that PowerShell and cmd cannot parse. Delete a line to fall back to the next
# rung (the process environment, then the default `warn`).
#
# silent | error | warn | info | debug      (default: warn)
P2PTS_LOG_LEVEL=
# 1 turns on the [CEREMONY] OOBI→RFI→RFA trace lines. Independent of the level
# above, so tracing still works with P2PTS_LOG_LEVEL=warn.
CEREMONY_TRACE=

