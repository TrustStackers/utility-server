{
  "name": "utility-server",
  "version": "0.1.0",
  "description": "P2P Trust Stack utility server — SQLite-backed REST API + libp2p/TSP node implementing the full P2PTS data schema (infrastructure, trust spanning, trust tasks, governance, trust applications).",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "P2PTS_LOG_LEVEL=info node --experimental-strip-types --loader ./test-loader.mjs src/index.ts",
    "dev": "P2PTS_LOG_LEVEL=info node --experimental-strip-types --loader ./test-loader.mjs --watch src/index.ts",
    "migrate": "node --experimental-strip-types --loader ./test-loader.mjs src/scripts/migrate.ts",
    "routes": "node --experimental-strip-types --loader ./test-loader.mjs src/scripts/list-routes.ts",
    "reconcile:identities": "node --experimental-strip-types --loader ./test-loader.mjs src/scripts/reconcile-identities.ts",
    "init:bootstrap": "node --experimental-strip-types --loader ./test-loader.mjs ./scripts/init-bootstrap-env.ts",
    "test": "node --experimental-strip-types --loader ./test-loader.mjs --test 'test/*.test.ts' 'test/**/*.test.ts' 'test/**/**/*.test.ts'"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@fastify/static": "^10.1.0",
    "@libp2p/circuit-relay-v2": "^4.2.8",
    "@libp2p/crypto": "^5.1.21",
    "@libp2p/identify": "^4.1.9",
    "@libp2p/peer-id": "^6.0.11",
    "@libp2p/ping": "^3.1.8",
    "@libp2p/tcp": "^11.0.22",
    "@libp2p/websockets": "^10.1.16",
    "@multiformats/multiaddr": "^13.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@p2p-trust-stack/core": "^0.1.0",
    "@types/pg": "^8.20.4",
    "@types/uuid": "^10.0.0",
    "cytoscape": "^3.30.3",
    "fastify": "^5.10.0",
    "libp2p": "^3.3.4",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^6.0.3"
  }
}
